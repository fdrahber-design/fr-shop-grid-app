{
  "name": "fr-shop-grid-app",
  "version": "1.0.0",
  "private": true,
  "description": "FR SHOP GRID mobile and desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "build:windows": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "electron": "38.3.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.frdevelopers.shopgrid",
    "productName": "FR SHOP GRID",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "FR-SHOP-GRID-Windows-${version}.exe"
    }
  }
}
