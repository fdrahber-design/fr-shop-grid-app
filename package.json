{
  "name": "fr-storepilot-app",
  "version": "1.1.0",
  "private": true,
  "description": "FR StorePilot mobile and desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "assets:generate": "node scripts/generate-assets.cjs",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "build:windows": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.4.3",
    "electron": "38.3.0",
    "electron-builder": "26.0.12",
    "sharp": "0.34.3"
  },
  "build": {
    "appId": "com.frdevelopers.storepilot",
    "productName": "FR StorePilot",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "FR-StorePilot-Windows-${version}.exe"
    }
  }
}
